{
  "name": "motion-design",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Instagram Reels edited in code from raw footage with Remotion + Anime.js",
  "scripts": {
    "dev": "node tools/studio.mjs",
    "ingest": "node --env-file-if-exists=.env tools/ingest.mjs",
    "cut": "node tools/cut.mjs",
    "audio": "node --env-file-if-exists=.env tools/audio.mjs",
    "still": "node tools/still.mjs",
    "thumbnail": "node tools/thumbnail.mjs",
    "redact": "node tools/redact.mjs",
    "render": "node tools/render.mjs",
    "catalog": "node tools/catalog.mjs",
    "check": ".venv/bin/python -I tools/audiocheck.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/elevenlabs": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "animejs": "4.5.0",
    "lucide-react": "0.460.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538",
    "simple-icons": "13.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
